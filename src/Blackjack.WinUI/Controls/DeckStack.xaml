<UserControl
    x:Class="Blackjack.WinUI.Controls.DeckStack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Monospace text keeps every character on the same grid cell as the console,
         so the footprint is DeckStackLayout.Width x DeckStackLayout.TotalHeight cells.
         The art is decorative; the control's AutomationProperties.Name carries the meaning. -->
    <StackPanel>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RefillStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Refilled">
                    <VisualState.Setters>
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="StackText.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TextBlock x:Name="TitleText"
                   AutomationProperties.AccessibilityView="Raw"
                   FontFamily="Consolas"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   IsTextScaleFactorEnabled="False" />
        <TextBlock x:Name="StackText"
                   AutomationProperties.AccessibilityView="Raw"
                   FontFamily="Consolas"
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   IsTextScaleFactorEnabled="False" />
    </StackPanel>
</UserControl>
