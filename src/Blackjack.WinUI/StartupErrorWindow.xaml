<Window
    x:Class="Blackjack.WinUI.StartupErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Blackjack">
    <!-- Shown instead of the game when it cannot start. A dialog needs a window to live in and there
         is no game window yet, so this small window is the error dialog: heading, message, one
         button. The message is a live region and the button has focus, so a screen reader reads the
         problem and Enter closes the app. -->
    <Grid x:Name="Root"
          Padding="24"
          RowSpacing="16"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   Grid.Row="0"
                   Style="{ThemeResource SubtitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1">
            <TextBlock x:Name="MessageText"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Assertive" />
        </ScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Content="Close"
                Style="{ThemeResource AccentButtonStyle}"
                Click="OnCloseClick"
                AutomationProperties.Name="Close" />
    </Grid>
</Window>
