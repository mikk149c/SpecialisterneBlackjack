<ContentDialog
    x:Class="Blackjack.WinUI.Dialogs.BetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:Blackjack.Presentation"
    Title="{x:Bind presentation:BetPrompt.Title}"
    PrimaryButtonText="{x:Bind presentation:BetPrompt.ConfirmLabel}"
    CloseButtonText="{x:Bind presentation:BetPrompt.CancelLabel}"
    DefaultButton="Primary">
    <!-- A TextBox rather than a NumberBox: a NumberBox rewrites or clears text it cannot parse, so
         "abc" would never reach the controller, which owns the parsing and the console's messages.
         The raw text is passed on unchanged. Enter presses the default (Deal) button, Esc presses
         the close (Cancel) button. -->
    <StackPanel Spacing="8">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="BetInput"
                 InputScope="Number"
                 AutomationProperties.LabeledBy="{x:Bind PromptText}" />
    </StackPanel>
</ContentDialog>
